---
interface Props {
  rating: number;
  size?: 'sm' | 'md';
}

const { rating, size = 'md' } = Astro.props;

const sizeClasses = size === 'sm' ? 'h-10 w-10 text-sm' : 'h-14 w-14 text-lg';
---

<span
  class={`inline-flex ${sizeClasses} items-center justify-center rounded-full bg-navy-950 font-bold text-signal`}
  aria-label={`Vurdering: ${rating.toFixed(1)} av 10`}
>
  {rating.toFixed(1)}
</span>
