---
import OddsBox from '@/components/OddsBox.astro';

interface Props {
  home: string;
  away: string;
  league: string;
  kickoff: Date;
  market: string;
  odds: number;
  bookmakerName: string;
  affiliateUrl: string;
  confidence: number;
  reasoning: string;
}

const { home, away, league, kickoff, market, odds, bookmakerName, affiliateUrl, confidence, reasoning } =
  Astro.props;
---

<article class="grid gap-4 rounded-lg border border-navy-700/15 bg-white p-5 shadow-sm md:grid-cols-[1fr_auto]">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim">{league}</p>
    <h3 class="mt-1 text-lg font-bold text-navy-950">{home} – {away}</h3>
    <time datetime={kickoff.toISOString()} class="text-sm text-ink-dim">
      {kickoff.toLocaleString('nb-NO', { dateStyle: 'medium', timeStyle: 'short' })}
    </time>
    <p class="mt-3 text-sm leading-relaxed text-ink">{reasoning}</p>
  </div>

  <div class="md:w-64">
    <OddsBox
      market={market}
      odds={odds}
      bookmakerName={bookmakerName}
      affiliateUrl={affiliateUrl}
      confidence={confidence}
    />
  </div>
</article>
