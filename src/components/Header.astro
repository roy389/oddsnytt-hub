---
import { AGE_LIMIT_LABEL, SITE_NAME } from '@/lib/constants';

const navLinks = [
  { href: '/', label: 'Forsiden' },
  { href: '/oddstips/', label: 'Dagens oddstips' },
  { href: '/nyheter/', label: 'Nyheter' },
  { href: '/bookmakere/', label: 'Bookmakere' },
];
---

<header class="bg-navy-950 text-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-paper">
      {SITE_NAME}
    </a>

    <nav class="hidden gap-6 text-sm font-medium md:flex" aria-label="Hovedmeny">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-paper/90 transition-colors hover:text-signal">
            {link.label}
          </a>
        ))
      }
    </nav>

    <span
      class="rounded border border-signal/60 px-2 py-1 text-xs font-bold text-signal"
      title="Kun for spillere over 18 år"
    >
      {AGE_LIMIT_LABEL}
    </span>
  </div>
</header>
