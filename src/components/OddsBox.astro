---
interface Props {
  market: string;
  odds: number;
  bookmakerName: string;
  affiliateUrl: string;
  confidence?: number;
  fetchedAt?: Date;
}

const { market, odds, bookmakerName, affiliateUrl, confidence, fetchedAt } = Astro.props;
---

<div class="flex flex-col gap-2 rounded-lg border border-line/20 bg-card p-4 shadow-sm">
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm font-medium text-muted">{market}</p>
    <p class="text-2xl font-bold text-heading">{odds.toFixed(2)}</p>
  </div>

  {
    confidence && (
      <p class="text-xs text-muted" aria-label={`Tillit: ${confidence} av 5`}>
        {'●'.repeat(confidence)}
        {'○'.repeat(5 - confidence)}
      </p>
    )
  }

  <a
    href={affiliateUrl}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="inline-flex items-center justify-center rounded bg-signal px-3 py-2 text-sm font-bold text-signal-contrast hover:bg-signal-dark"
  >
    Spill hos {bookmakerName}
  </a>
  <p class="text-[11px] uppercase tracking-wide text-muted/70">
    Annonselenke
    {fetchedAt && <> · Odds hentet {fetchedAt.toLocaleString('nb-NO')}, kan endres</>}
  </p>
</div>
