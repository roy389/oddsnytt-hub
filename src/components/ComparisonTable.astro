---
import RatingBadge from '@/components/RatingBadge.astro';
import BookmakerLogo from '@/components/BookmakerLogo.astro';

interface ComparisonRow {
  name: string;
  slug: string;
  rating: number;
  bonusHeadline: string;
  minDeposit: string;
  affiliateUrl: string;
  logo?: string;
  logoAlt?: string;
  logoTheme?: 'light' | 'dark';
}


interface Props {
  bookmakers: ComparisonRow[];
}

const { bookmakers } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-line/15">
  <table class="w-full min-w-[640px] border-collapse bg-card text-left text-sm">
    <thead class="bg-inkwell text-paper">
      <tr>
        <th class="px-4 py-3 font-semibold">Bookmaker</th>
        <th class="px-4 py-3 font-semibold">Vurdering</th>
        <th class="px-4 py-3 font-semibold">Bonus</th>
        <th class="px-4 py-3 font-semibold">Min. innskudd</th>
        <th class="px-4 py-3 font-semibold">
          <span class="sr-only">Handling</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        bookmakers.map((bookmaker) => (
          <tr class="border-t border-line/10">
            <td class="px-4 py-3 font-medium text-heading">
              <div class="flex items-center gap-3">
                <BookmakerLogo
                  src={bookmaker.logo}
                  alt={bookmaker.logoAlt ?? `${bookmaker.name} logo`}
                  theme={bookmaker.logoTheme ?? 'light'}
                  class="h-10 w-20"
                />
                <a href={`/bookmakere/${bookmaker.slug}/`} class="hover:text-signal-dark">
                  {bookmaker.name}
                </a>
              </div>
            </td>
            <td class="px-4 py-3">
              <RatingBadge rating={bookmaker.rating} size="sm" />
            </td>
            <td class="px-4 py-3 text-muted">{bookmaker.bonusHeadline}</td>
            <td class="px-4 py-3 text-muted">{bookmaker.minDeposit}</td>
            <td class="px-4 py-3 text-right">
              <a
                href={bookmaker.affiliateUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="inline-flex items-center justify-center whitespace-nowrap rounded bg-signal px-3 py-1.5 text-xs font-bold text-signal-contrast hover:bg-signal-dark"
              >
                Spill her
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="border-t border-line/10 bg-canvas-dim px-4 py-2 text-[11px] uppercase tracking-wide text-muted/70">
    Annonselenker
  </p>
</div>
