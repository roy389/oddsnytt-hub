---
import RatingBadge from '@/components/RatingBadge.astro';
import BookmakerLogo from '@/components/BookmakerLogo.astro';

interface Props {
  name: string;
  slug: string;
  rating: number;
  bonusHeadline: string;
  affiliateUrl: string;
  pros: string[];
  logo?: string;
  logoAlt?: string;
  logoTheme?: 'light' | 'dark';
}

const {
  name,
  slug,
  rating,
  bonusHeadline,
  affiliateUrl,
  pros,
  logo,
  logoAlt,
  logoTheme = 'light',
} = Astro.props;
---

<article class="flex flex-col gap-4 rounded-lg border border-navy-700/15 bg-white p-5 shadow-sm sm:flex-row sm:items-center">
  <RatingBadge rating={rating} />
  <BookmakerLogo src={logo} alt={logoAlt ?? `${name} logo`} theme={logoTheme} />

  <div class="flex-1">
    <h3 class="text-lg font-bold text-navy-950">
      <a href={`/bookmakere/${slug}/`} class="hover:text-signal-dark">{name}</a>
    </h3>
    <p class="text-sm text-ink-dim">{bonusHeadline}</p>
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-dim">
      {pros.slice(0, 3).map((pro) => <li>✓ {pro}</li>)}
    </ul>
  </div>

  <div class="flex flex-col items-start gap-1 sm:items-end">
    <a
      href={affiliateUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="inline-flex items-center justify-center rounded bg-signal px-4 py-2 text-sm font-bold text-signal-contrast hover:bg-signal-dark"
    >
      Besøk {name}
    </a>
    <p class="text-[11px] uppercase tracking-wide text-ink-dim/70">Annonselenke</p>
  </div>
</article>
