---
import Layout from '@/layouts/Layout.astro';
import { getPublishableTips } from '@/lib/content';

const title = 'Dagens oddstips – analyser og spillforslag';
const description =
  'Dagens oddstips fra Oddsnytt: datadrevne analyser av kamper i fotball, tennis, basketball og ishockey, med begrunnelse og odds fra våre samarbeidspartnere.';

const publishableTips = await getPublishableTips();
const days = publishableTips
  .map(({ entry, matches }) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    sport: entry.data.sport,
    matchCount: matches.length,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-navy-950">Dagens oddstips</h1>
    <p class="mt-3 max-w-2xl text-ink-dim">
      Datadrevne analyser og vurderinger, ikke garantier. Se alltid gjeldende odds hos bookmaker
      før du spiller.
    </p>

    {
      days.length === 0 ? (
        <p class="mt-10 text-ink-dim">Ingen oddstips er publisert ennå.</p>
      ) : (
        <div class="mt-10 flex flex-col gap-4">
          {days.map((day) => (
            <a
              href={`/oddstips/${day.id}/`}
              class="flex items-center justify-between rounded-lg border border-navy-700/15 bg-white p-5 shadow-sm hover:border-signal"
            >
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim">{day.sport}</p>
                <h2 class="mt-1 text-lg font-bold text-navy-950">{day.title}</h2>
              </div>
              <p class="text-sm text-ink-dim">{day.matchCount} kamper</p>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
