---
import Layout from '@/layouts/Layout.astro';

const title = 'Personvern – Oddsnytt';
const description =
  'Personvernerklæring for Oddsnytt: hvilke informasjonskapsler vi bruker, hvordan samtykke fungerer, og hvordan vi håndterer eventuelle personopplysninger fra besøkende.';
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-heading">Personvernerklæring</h1>

    <h2 class="mt-8 text-xl font-bold text-heading">Informasjonskapsler (cookies)</h2>
    <p class="mt-3 text-muted">
      Oddsnytt bruker nødvendige informasjonskapsler for at nettstedet skal fungere. Statistikk-
      og annonsekapsler, inkludert kapsler knyttet til affiliate-lenker, settes først etter at du
      har gitt samtykke i cookie-banneret.
    </p>

    <h2 class="mt-8 text-xl font-bold text-heading">Samtykke</h2>
    <p class="mt-3 text-muted">
      Ditt valg lagres lokalt i nettleseren din. Du kan når som helst tømme nettleserdataene dine
      for å bli spurt på nytt.
    </p>
  </section>
</Layout>
