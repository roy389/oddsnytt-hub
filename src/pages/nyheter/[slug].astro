---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import { SITE_NAME } from '@/lib/constants';

export async function getStaticPaths() {
  const allNews = await getCollection('nyheter');
  const withAuthors = await Promise.all(
    allNews.map(async (entry) => ({ entry, author: await getEntry(entry.data.author) })),
  );
  return withAuthors
    .filter((item): item is typeof item & { author: NonNullable<typeof item.author> } =>
      Boolean(item.author),
    )
    .map(({ entry, author }) => ({
      params: { slug: entry.id },
      props: { entry, author },
    }));
}

const { entry, author } = Astro.props;
const article = entry.data;
const { Content } = await render(entry);

const newsArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title,
  datePublished: article.date.toISOString(),
  author: {
    '@type': 'Person',
    name: author.data.name,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
  },
  image: new URL(article.image, Astro.site).toString(),
};
---

<Layout
  title={article.title}
  description={article.description}
  ogImage={article.image}
  ogImageAlt={article.imageAlt}
  structuredData={[newsArticleLd]}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim">{article.category}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-950">{article.title}</h1>

    <div class="mt-3">
      <AuthorByline authorName={author.data.name} authorField={author.data.fagfelt} date={article.date} />
    </div>

    <img
      src={article.image}
      alt={article.imageAlt}
      width="1200"
      height="675"
      loading="lazy"
      class="mt-6 w-full rounded-lg object-cover"
    />

    <div class="content-body mt-6">
      <Content />
    </div>

    {
      article.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-medium text-ink-dim">{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</Layout>
