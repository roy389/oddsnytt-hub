---
import { getCollection, getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const title = 'Sportsnyheter – Oddsnytt';
const description =
  'Daglige sportsnyheter fra Oddsnytt, skrevet av våre faste journalister. Fotball, tennis, håndball og annen toppidrett, alltid faktabasert og uten clickbait.';

const allNews = await getCollection('nyheter');
const news = [...allNews].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const newsWithAuthors = await Promise.all(
  news.map(async (entry) => ({
    entry,
    author: await getEntry(entry.data.author),
  })),
);
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-navy-950">Sportsnyheter</h1>
    <p class="mt-3 max-w-2xl text-ink-dim">
      Journalistisk skrevne sportsnyheter fra våre faste skribenter.
    </p>

    {
      newsWithAuthors.length === 0 ? (
        <p class="mt-10 text-ink-dim">Ingen nyhetsartikler er publisert ennå.</p>
      ) : (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {newsWithAuthors.map(({ entry, author }) => (
            <a
              href={`/nyheter/${entry.id}/`}
              class="flex flex-col gap-2 rounded-lg border border-navy-700/15 bg-white p-5 shadow-sm hover:border-signal"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim">{entry.data.category}</p>
              <h2 class="text-lg font-bold text-navy-950">{entry.data.title}</h2>
              <p class="text-sm text-ink-dim">{entry.data.description}</p>
              {author && <p class="mt-auto text-xs text-ink-dim">{author.data.name}</p>}
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
