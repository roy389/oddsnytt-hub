---
import { getCollection, getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const title = 'Sportsnyheter – Oddsnytt';
const description =
  'Daglige sportsnyheter fra Oddsnytt, skrevet av våre faste journalister. Fotball, tennis, håndball og annen toppidrett, alltid faktabasert og uten clickbait.';

const allNews = await getCollection('nyheter');
const news = [...allNews].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const newsWithAuthors = await Promise.all(
  news.map(async (entry) => ({
    entry,
    author: await getEntry(entry.data.author),
  })),
);
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-heading">Sportsnyheter</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Journalistisk skrevne sportsnyheter fra våre faste skribenter.
    </p>

    {
      newsWithAuthors.length === 0 ? (
        <p class="mt-10 text-muted">Ingen nyhetsartikler er publisert ennå.</p>
      ) : (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {newsWithAuthors.map(({ entry, author }) => (
            <a
              href={`/nyheter/${entry.id}/`}
              class="flex flex-col overflow-hidden rounded-lg border border-line/15 bg-card shadow-sm transition-colors hover:border-signal"
            >
              <img
                src={entry.data.image}
                alt={entry.data.imageAlt}
                width="1200"
                height="675"
                loading="lazy"
                class="aspect-video w-full object-cover"
              />
              <div class="flex flex-1 flex-col gap-2 p-5">
                <span class="w-fit rounded-full bg-inkwell px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-signal">
                  {entry.data.category}
                </span>
                <h2 class="text-lg font-bold text-heading">{entry.data.title}</h2>
                <p class="text-sm text-muted">{entry.data.description}</p>
                {author && <p class="mt-auto pt-1 text-xs text-muted">{author.data.name}</p>}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
