---
import Layout from '@/layouts/Layout.astro';
import { HJELPELINJEN_PHONE, HJELPELINJEN_URL } from '@/lib/constants';

const title = 'Ansvarlig spilling – Oddsnytt';
const description =
  'Ansvarlig spilling hos Oddsnytt: lær å kjenne igjen faresignaler, sett grenser for eget spill, og finn hjelp hos Hjelpelinjen når spillet føles ute av kontroll.';
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-heading">Ansvarlig spilling</h1>

    <p class="mt-4 text-muted">
      Spill skal være underholdning, ikke en inntektskilde eller en løsning på økonomiske problemer.
      Oddsnytt oppfordrer alle lesere til å spille ansvarlig og sette klare grenser før man spiller.
    </p>

    <h2 class="mt-8 text-xl font-bold text-heading">Tegn på at spillingen har blitt et problem</h2>
    <ul class="mt-3 list-disc space-y-2 pl-6 text-muted">
      <li>Du spiller for mer penger enn du har råd til å tape.</li>
      <li>Du låner penger eller selger eiendeler for å spille.</li>
      <li>Du prøver å spille inn igjen tap («jage tap»).</li>
      <li>Spillingen går utover jobb, skole, familie eller venner.</li>
      <li>Du skjuler omfanget av spillingen din for andre.</li>
    </ul>

    <h2 class="mt-8 text-xl font-bold text-heading">Verktøy for å begrense spillingen</h2>
    <p class="mt-3 text-muted">
      De fleste norske og lisensierte bookmakere tilbyr innskuddsgrenser, tapsgrenser og
      selvutestengelse. I Norge kan du også stenge deg selv ute fra alle spillselskaper med
      norsk lisens via Hjelpelinjens verktøy.
    </p>

    <h2 class="mt-8 text-xl font-bold text-heading">Trenger du hjelp?</h2>
    <p class="mt-3 text-muted">
      Hjelpelinjen er en gratis og landsdekkende hjelpetjeneste for spilleavhengighet i Norge.
    </p>
    <p class="mt-3 font-semibold text-heading">
      <a href={HJELPELINJEN_URL} class="text-signal-dark hover:underline" rel="noopener">
        hjelpelinjen.no
      </a>
      {' '}· Telefon{' '}
      <a href={`tel:${HJELPELINJEN_PHONE.replace(/\s/g, '')}`} class="text-signal-dark hover:underline">
        {HJELPELINJEN_PHONE}
      </a>
    </p>
  </section>
</Layout>
