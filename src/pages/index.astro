---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { RISK_DISCLAIMER } from '@/lib/constants';

const title = 'Oddsnytt – oddstips, nyheter og bookmakere';
const description =
  'Oddsnytt gir deg dagens oddstips, ferske sportsnyheter og grundige bookmakeromtaler samlet på ett sted – analysert av erfarne sportsjournalister.';

const allNews = await getCollection('nyheter');
const latestNews = [...allNews]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-bold text-heading">Oddsnytt</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Dagens oddstips, daglige sportsnyheter og grundige bookmakeromtaler – samlet på ett sted.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <a href="/oddstips/" class="rounded-lg border border-line/15 bg-card p-6 shadow-sm hover:border-signal">
        <h2 class="text-lg font-bold text-heading">Dagens oddstips</h2>
        <p class="mt-2 text-sm text-muted">Datadrevne spilltips publisert hver morgen.</p>
      </a>
      <a href="/nyheter/" class="rounded-lg border border-line/15 bg-card p-6 shadow-sm hover:border-signal">
        <h2 class="text-lg font-bold text-heading">Daglige nyheter</h2>
        <p class="mt-2 text-sm text-muted">Journalistisk skrevne sportsnyheter.</p>
      </a>
      <a href="/bookmakere/" class="rounded-lg border border-line/15 bg-card p-6 shadow-sm hover:border-signal">
        <h2 class="text-lg font-bold text-heading">Bookmakeromtaler</h2>
        <p class="mt-2 text-sm text-muted">Grundige anmeldelser og sammenligning.</p>
      </a>
    </div>

    {
      latestNews.length > 0 && (
        <div class="mt-16">
          <div class="flex items-baseline justify-between">
            <h2 class="text-xl font-bold text-heading">Siste nyheter</h2>
            <a href="/nyheter/" class="text-sm font-medium text-signal-dark hover:underline">
              Se alle nyheter →
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {latestNews.map((entry) => (
              <a
                href={`/nyheter/${entry.id}/`}
                class="flex flex-col overflow-hidden rounded-lg border border-line/15 bg-card shadow-sm transition-colors hover:border-signal"
              >
                <img
                  src={entry.data.image}
                  alt={entry.data.imageAlt}
                  width="1200"
                  height="675"
                  loading="lazy"
                  class="aspect-video w-full object-cover"
                />
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <span class="w-fit rounded-full bg-inkwell px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-signal">
                    {entry.data.category}
                  </span>
                  <h3 class="text-base font-bold text-heading">{entry.data.title}</h3>
                  <p class="text-sm text-muted">{entry.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <p class="mt-12 max-w-2xl text-sm text-muted">{RISK_DISCLAIMER}</p>
  </section>
</Layout>
