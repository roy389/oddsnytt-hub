---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import BookmakerCard from '@/components/BookmakerCard.astro';
import BookmakerDraftCard from '@/components/BookmakerDraftCard.astro';
import ComparisonTable from '@/components/ComparisonTable.astro';
import { isPublishedBookmaker } from '@/lib/content';

const title = 'Bookmakeromtaler – sammenlign norske bookmakere';
const description =
  'Sammenlign bookmakere med vurdering, bonusbetingelser og minimumsinnskudd. Grundige, verifiserte omtaler av bookmakere som tilbyr odds til norske spillere.';

const allBookmakers = await getCollection('bookmakere');
const bookmakers = allBookmakers
  .filter(isPublishedBookmaker)
  .sort((a, b) => b.data.rating - a.data.rating);

const drafts = allBookmakers
  .filter((entry) => !isPublishedBookmaker(entry))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'nb-NO'));

const comparisonRows = bookmakers.map((entry) => ({
  name: entry.data.name,
  slug: entry.id,
  rating: entry.data.rating,
  bonusHeadline: entry.data.bonus.headline,
  minDeposit: entry.data.bonus.minDeposit,
  affiliateUrl: entry.data.affiliateUrl,
  logo: entry.data.logo,
  logoAlt: entry.data.logoAlt,
  logoTheme: entry.data.logoTheme,
}));
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-navy-950">Bookmakeromtaler</h1>
    <p class="mt-3 max-w-2xl text-ink-dim">
      Vi tester og vurderer bookmakere ut fra odds, bonusbetingelser, betalingsløsninger og
      support. Alle fakta verifiseres før publisering.
    </p>

    {
      bookmakers.length === 0 ? (
        <p class="mt-10 text-ink-dim">Ingen verifiserte bookmakeromtaler er publisert ennå.</p>
      ) : (
        <>
          <div class="mt-10">
            <h2 class="text-lg font-bold text-navy-950">Rask sammenligning</h2>
            <div class="mt-4">
              <ComparisonTable bookmakers={comparisonRows} />
            </div>
          </div>

          <h2 class="mt-12 text-lg font-bold text-navy-950">Anmeldelsene i detalj</h2>
          <div class="mt-4 flex flex-col gap-4">
            {bookmakers.map((entry) => (
              <BookmakerCard
                name={entry.data.name}
                slug={entry.id}
                rating={entry.data.rating}
                bonusHeadline={entry.data.bonus.headline}
                affiliateUrl={entry.data.affiliateUrl}
                pros={entry.data.pros}
                logo={entry.data.logo}
                logoAlt={entry.data.logoAlt}
                logoTheme={entry.data.logoTheme}
              />
            ))}
          </div>
        </>
      )
    }

    {
      drafts.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-bold text-navy-950">Bookmakere under gjennomgang</h2>
          <p class="mt-2 max-w-2xl text-sm text-ink-dim">
            Disse operatørene er registrert hos oss, men omtalene er ikke ferdig verifisert. Vi viser
            logo og operatørens egen beskrivelse, uten vurdering, bonusanbefaling eller affiliatelenke.
          </p>
          <div class="mt-6 flex flex-col gap-4">
            {drafts.map((entry) => (
              <BookmakerDraftCard
                name={entry.data.name}
                logo={entry.data.logo}
                logoAlt={entry.data.logoAlt}
                logoTheme={entry.data.logoTheme}
                operatorSummary={entry.data.operatorSummary}
                siteUrl={entry.data.affiliateUrl}
              />
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>
