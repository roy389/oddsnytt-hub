---
import Layout from '@/layouts/Layout.astro';

const title = 'Om oss – Oddsnytt';
const description =
  'Oddsnytt er en norsk redaksjon for sportsbetting som leverer oddstips, sportsnyheter og bookmakeromtaler, med åpenhet om annonseinntekter og faktagrunnlag.';
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-navy-950">Om Oddsnytt</h1>
    <p class="mt-4 text-ink-dim">
      Oddsnytt er en norskspråklig redaksjon som dekker sportsbetting gjennom dagens oddstips,
      sportsnyheter og bookmakeromtaler. Vi finansieres av annonselenker til bookmakere, tydelig
      merket i alt innhold der de forekommer.
    </p>
    <p class="mt-4 text-ink-dim">
      Alle fakta om bookmakere – lisenser, bonusbetingelser, eierskap – verifiseres før publisering.
      Der informasjon mangler, merker vi det tydelig i stedet for å gjette.
    </p>
  </section>
</Layout>
